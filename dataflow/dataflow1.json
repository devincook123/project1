{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DelimitedText1",
						"type": "DatasetReference"
					},
					"name": "customerload"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "AzureSqlTable3",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "nameextraction"
				},
				{
					"name": "PhoneNumbers"
				},
				{
					"name": "Email"
				}
			],
			"scriptLines": [
				"source(output(",
				"          CustomerID as string,",
				"          Name as string,",
				"          Email as string,",
				"          Phone as string,",
				"          LastPurchaseDate as string,",
				"          TotalSpent as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> customerload",
				"customerload derive(FirstName = regexExtract(Name, \"^(Mr\\\\.|Mrs\\\\.|Ms\\\\.|Dr\\\\.|Prof\\\\.Miss)? ?([A-Za-z]+)\", 2),",
				"          LastName = regexExtract(Name, \"^(Mr\\\\.|Mrs\\\\.|Ms\\\\.|Dr\\\\.|Prof\\\\.|Miss)? ?[A-Za-z]+\\\\s+([A-Za-z'-]+)\", 2)) ~> nameextraction",
				"nameextraction derive(Phone = iif(\r",
				"    length(replace(replace(replace(replace(Phone, ' ', ''), '-', ''), '(', ''), ')', '')) == 10,\r",
				"    concat(\r",
				"        '(', substring(replace(replace(replace(replace(Phone, ' ', ''), '-', ''), '(', ''), ')', ''), 0, 3), ') ',\r",
				"        substring(replace(replace(replace(replace(Phone, ' ', ''), '-', ''), '(', ''), ')', ''), 3, 3), '-',\r",
				"        substring(replace(replace(replace(replace(Phone, ' ', ''), '-', ''), '(', ''), ')', ''), 6, 4)\r",
				"    ),\r",
				"    ''\r",
				")) ~> PhoneNumbers",
				"PhoneNumbers derive(Email = trim(lower(Email))) ~> Email",
				"Email sink(allowSchemaDrift: false,",
				"     validateSchema: true,",
				"     input(",
				"          customer_id as integer,",
				"          first_name as string,",
				"          last_name as string,",
				"          primary_email as string,",
				"          phone_number as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          customer_id = CustomerID,",
				"          first_name = Name,",
				"          last_name = Name,",
				"          primary_email = Email,",
				"          phone_number = Phone",
				"     )) ~> sink1"
			]
		}
	}
}